{
  "blueprints": {
    "Retention": {
      "name": "Retention",
      "description": "Ultra-fast paced YouTube retention style optimized for watch time. Hyper-active cuts, immediate removal of pauses, punch-ins on repetitive phrasing, and prominent SFX accents.",
      "aspect_ratio": "16:9",
      "width": 1920,
      "height": 1080,
      "fps": 30.0,
      "rules": {
        "max_silence_duration_sec": 0.25,
        "silence_breath_padding_sec": 0.06,
        "punch_in_scale_factor": 1.08,
        "punch_in_min_interval_sec": 3.0,
        "b_roll_min_interval_sec": 2.5,
        "b_roll_max_duration_sec": 4.0,
        "j_l_cut_offset_sec": 0.25,
        "music_ducking_attenuation_db": -22.0,
        "music_regular_gain_db": -10.0,
        "audio_loudness_target_lufs": -14.0,
        "enable_jump_cut_punch_in": true,
        "enable_motion_overlays": true,
        "enable_sound_fx": true,
        "default_transition": "cut"
      }
    },
