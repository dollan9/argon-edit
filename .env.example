# ==============================================================================
# PROJECT ARGON-EDIT CONFIGURATION
# ==============================================================================

# NVIDIA NIM API Credentials
# Get your key from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
DIRECTOR_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
DIRECTOR_FALLBACK_MODEL=meta/llama-3.3-70b-instruct
VISION_MODEL=meta/llama-3.2-90b-vision-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
WHISPER_MODEL_SIZE=large-v3-turbo

# Adobe CEP Bridge Ports & Hosts
PPRO_BRIDGE_PORT=8088
AEFT_BRIDGE_PORT=8089
PHXS_BRIDGE_PORT=8090
PPRO_BRIDGE_URL=http://localhost:8088
AEFT_BRIDGE_URL=http://localhost:8089
PHXS_BRIDGE_URL=http://localhost:8090

# Workspace & Project Paths
WORKSPACE_DIR=./workspace
STATE_DB_PATH=./data/argon_state.db
STYLE_MEMORY_DIR=./data/style_memory

# Adobe Application Executables (Windows paths by default)
PREMIERE_PATH=C:/Program Files/Adobe/Adobe Premiere Pro 2024/Adobe Premiere Pro.exe
AFTEREFFECTS_PATH=C:/Program Files/Adobe/Adobe After Effects 2024/Support Files/AfterFX.exe
PHOTOSHOP_PATH=C:/Program Files/Adobe/Adobe Photoshop 2024/Photoshop.exe

# Safety & Hardware Limits (System RAM 16GB, GPU VRAM 10GB)
MAX_WORKER_CONCURRENCY=2
AUDIO_LUFS_TARGET=-14.0
DEFAULT_PACING_BLUEPRINT=Retention
